# JPBazaar Environment Variable Template
# Copy this file to .env and populate values for local development.

DB_URL=jdbc:postgresql://localhost:5432/jpbazaar
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
