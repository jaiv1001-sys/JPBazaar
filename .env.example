# ==============================================================================
# JPBazaar E-Commerce API - Environment Variables Template
# Provide these variables in your hosting provider (Render / Railway / Docker)
# ==============================================================================

# 1. Environment & Profiles
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# 2. Database (Managed PostgreSQL: Neon / Supabase / Render / Railway)
DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>
JPA_DDL_AUTO=validate

# 3. Security & JWT (Generate a 64+ character random hex key)
# e.g.: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 4. CORS Origins (Strictly your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://jpbazaar.vercel.app

# 5. Client Facing URL (Used in HTML email tracking buttons)
APP_FRONTEND_URL=https://jpbazaar.vercel.app

# 6. Razorpay Gateway (TEST MODE)
RAZORPAY_KEY_ID=rzp_test_JPBazaarDemoKey123
RAZORPAY_KEY_SECRET=JPBazaarDemoSecretKey456
RAZORPAY_WEBHOOK_SECRET=JPBazaarWebhookSecret789
RAZORPAY_CURRENCY=INR
RAZORPAY_ENABLED=true

# 7. Email Notifications (SMTP: Gmail / SendGrid / Amazon SES / Brevo)
APP_MAIL_ENABLED=true
APP_MAIL_FROM=concierge@jpbazaar.com
APP_MAIL_FROM_NAME=JPBazaar Luxury Concierge
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# 8. Caching & Performance
CACHE_TYPE=simple
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=false
# If Redis provisioned:
# CACHE_TYPE=redis
# RATE_LIMIT_USE_REDIS=true
# REDIS_HOST=redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=redis-password
